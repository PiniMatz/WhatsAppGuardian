# --- Required ---
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Optional: override the Gemini model (default tries gemini-3.5-flash, then gemini-2.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# --- Security (set BOTH on Render; if unset the server is open and logs a warning) ---
# Password for the parent dashboard (browser asks for it; any username works)
DASHBOARD_PASSWORD=choose_a_long_password
# Secret the phone app sends in the X-Device-Token header. Must match the GitHub secret DEVICE_TOKEN used to build the APK.
DEVICE_TOKEN=choose_a_long_random_token

# --- Telegram alerts (optional) ---
# Create a bot with @BotFather, then message it and read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to false to send only names/category (not the message text) to Telegram
TELEGRAM_INCLUDE_TEXT=true
# Only notify when the AI confidence is at least this value
NOTIFY_MIN_CONFIDENCE=0.5
# Public dashboard URL, appended to Telegram messages
PUBLIC_URL=https://whatsappguardian.onrender.com

# --- Retention (optional) ---
# Auto-delete UNSAVED alerts older than N days. 0 = keep forever.
RETENTION_DAYS=0
